{
  "name": "ccdb-cli-development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pack:local": "node scripts/pack.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run pack:local && npm test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "cli": "tsx packages/ccdb-cli/src/main.ts"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.27.0",
    "prettier": "2.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
