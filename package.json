{
  "name": "ccdb-cli-development",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ccdb-cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "npm run build && node scripts/build-native.mjs",
    "test:native": "node scripts/test-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pack:local": "node scripts/pack.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run build && npm run pack:local && npm test",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "cli": "tsx packages/ccdb-cli/src/main.ts"
  },
  "dependencies": {
    "ccdb-client": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "2.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
